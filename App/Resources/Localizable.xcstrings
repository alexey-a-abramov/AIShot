    "After granting in System Settings, switch back to AIShot — status refreshes automatically." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras conceder el permiso en Ajustes del Sistema, vuelve a AIShot: el estado se actualiza automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après l’autorisation dans Réglages Système, revenez à AIShot — l’état se rafraîchit automatiquement."
