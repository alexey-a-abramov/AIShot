          }
        }
      }
    },
    "MCP (Model Context Protocol) is the open standard agents use to call tools. AIShot ships a local MCP server so assistants like Claude Code and Claude Desktop can see and act on your screen — entirely on your Mac." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP (Model Context Protocol) es el estándar abierto que los agentes usan para llamar a herramientas. AIShot incluye un servidor MCP local para que asistentes como Claude Code y Claude Desktop puedan ver tu pantalla y actuar sobre ella, todo en tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP (Model Context Protocol) est le standard ouvert que les agents utilisent pour appeler des outils. AIShot fournit un serveur MCP local pour que des assistants comme Claude Code et Claude Desktop puissent voir votre écran et agir dessus — entièrement sur votre Mac."
          }
        }
      }
    },
    "Mode" : {
      "extractionState" : "manual",
