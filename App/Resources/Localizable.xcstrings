    "Let on-device AI agents capture and read your screen." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que los agentes de IA locales capturen y lean tu pantalla."
          }
        },
        "fr" : {
