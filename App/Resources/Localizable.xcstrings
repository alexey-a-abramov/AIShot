    "An agent launches the bundled stdio bridge, which forwards JSON-RPC requests to AIShot. Every agent shares one capture authority, so your permission grants are reused." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agente inicia el puente stdio incluido, que reenvía las solicitudes JSON-RPC a AIShot. Todos los agentes comparten una única autoridad de captura, por lo que se reutilizan tus permisos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agent lance le pont stdio intégré, qui transmet les requêtes JSON-RPC à AIShot. Tous les agents partagent une même autorité de capture, vos autorisations sont donc réutilisées."
          }
        }
      }
    },
